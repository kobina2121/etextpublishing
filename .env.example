# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Phase 4) ----------------------------------------------------
# Include the database name in the path. Atlas copies its connection string as
# ".../?appName=..." with no database, which silently falls back to "test".
#   local : mongodb://127.0.0.1:27017/etextpublishing
#   atlas : mongodb+srv://USER:PASS@CLUSTER.mongodb.net/etextpublishing?appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/etextpublishing

# --- Auth (Phase 5) --------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# --- Google sign-in --------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (application type: Web application).
#
# Add BOTH of these as Authorised redirect URIs on that client:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
#
# Leave blank and Google sign-in is simply not offered — no button, no route.
# Signing in with Google never grants more than a customer account; an admin
# has to already exist with that email address to reach /admin.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Seed admin (Phase 4) --------------------------------------------------
# Used once by `npm run seed` to create the first admin user.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Site Administrator

# --- File storage, S3-compatible (Phase 7) ---------------------------------
# Works with AWS S3 or Cloudflare R2. Manuscripts stay private; cover images
# are served from a public prefix via NEXT_PUBLIC_ASSET_HOST.
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for R2 / MinIO; leave blank for AWS S3.
S3_ENDPOINT=
# Public hostname that serves the bucket's public prefix (no protocol).
NEXT_PUBLIC_ASSET_HOST=

# --- Email, Resend ---------------------------------------------------------
# Needed for magic-link sign-in and, later, form notifications.
# Without these, development prints emails to the server console instead of
# sending them. Production refuses to send at all rather than failing silently.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM=
# Internal recipients for form notifications.
EMAIL_TO_SUBMISSIONS=
EMAIL_TO_CONTACT=

# --- Payments, Paystack ----------------------------------------------------
# Test keys (sk_test_/pk_test_) are fine for development; live keys charge real
# money. The secret key must never be exposed to the browser — only the public
# key may be, and it is not needed for the redirect checkout used here.
#
# The webhook must be registered in the Paystack dashboard, pointing at
#   <your site>/api/webhooks/paystack
# Without it, an order is only settled if the buyer returns to the callback
# page, so a closed tab leaves a paid order sitting as pending.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
